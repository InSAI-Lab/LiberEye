# Generate a private .env with: python scripts/configure_cloud.py
LIBEREYE_API_TOKEN=
LIBEREYE_ALLOW_INSECURE=0
LIBEREYE_HOST=127.0.0.1
LIBEREYE_PORT=8080
LIBEREYE_CORS_ORIGINS=
LIBEREYE_MAX_UPLOAD_BYTES=16777216
LIBEREYE_MAX_IMAGE_PIXELS=16000000
LIBEREYE_MAX_SESSIONS=256
LIBEREYE_SESSION_TTL_S=900
LIBEREYE_LOG_LEVEL=info
LIBEREYE_MEMORY_LIMIT=4g

# The default is a CPU integration demo with heuristic perception.
# For trained inference, install .[vision], supply local weights and set REQUIRE_MODELS=1.
INSTALL_VISION=0
LIBEREYE_ENABLE_STRONG_VISION=0
LIBEREYE_REQUIRE_MODELS=0
# LIBEREYE_YOLO_MODEL=/models/general.pt
# LIBEREYE_SAM_MODEL=/models/sam.pt
# LIBEREYE_TACTILE_MODEL=/models/tactile.pt
# LIBEREYE_CROSSWALK_MODEL=/models/crosswalk.pt
# LIBEREYE_TRAFFIC_LIGHT_MODEL=/models/traffic_light.pt
# LIBEREYE_ROBOFLOW_API_KEY=

# Reader-managed HTTPS. Fill these in the private .env on your server.
# Shared example from the iOS code: libereye.example.org (placeholder only).
# LIBEREYE_DOMAIN takes only the hostname; the app Base URL adds https://.
# For example: LIBEREYE_DOMAIN=libereye.example.org
# For example: ACME_EMAIL=maintainer@example.org
# DNS must point to your server; inbound TCP 80/443 must be reachable.
LIBEREYE_DOMAIN=
ACME_EMAIL=
